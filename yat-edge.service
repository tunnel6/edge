[Unit]
Description=Edge Tunnel Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/edge server start --startup.config_b64=${STARTUP_CONFIG_B64}
Restart=always
RestartSec=5
Environment=EDGE_SECRET=${EDGE_SECRET}
Environment=STARTUP_CONFIG_B64=
WorkingDirectory=/var/lib/edge
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge /tmp
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target